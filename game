<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<title>Snake</title>
<meta name="theme-color" content="#4a752c">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" href="icons/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="icons/icon-192.png">
<style>
  :root{--bar:#4a752c;--ink:#fff;--g1:#aad751;--g2:#a2d149}
  *{box-sizing:border-box;margin:0}
  html,body{height:100%;background:#578a34;color:var(--ink);font-family:"Trebuchet MS","Segoe UI",system-ui,sans-serif;overflow:hidden;touch-action:none}
  body{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:env(safe-area-inset-top) 8px env(safe-area-inset-bottom)}
  .wrap{width:min(100%,calc((100vh - 24px) * 17 / 15 - 40px),680px);border-radius:10px;overflow:hidden;box-shadow:0 8px 30px #0005}
  .bar{background:var(--bar);display:flex;align-items:center;gap:22px;padding:10px 18px;font-size:clamp(16px,3.4vw,24px);font-weight:700}
  .bar img{height:1.5em;width:auto;vertical-align:-.35em;margin-right:.35em}
  .bar .sp{flex:1}
  .stage{position:relative}
  canvas{display:block;width:100%;height:auto;background:var(--g1)}
  .overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;background:#0000004d;text-align:center;padding:20px}
  .overlay.hide{display:none}
  .overlay h1{font-size:clamp(26px,6vw,44px)}
  .overlay p{font-size:clamp(14px,2.8vw,18px);opacity:.92}
  button{font:inherit;font-weight:700;font-size:clamp(16px,3vw,20px);color:#fff;background:#4674e9;border:0;border-radius:999px;padding:.6em 1.6em;cursor:pointer}
  button:hover{background:#3a62c8}
  button:focus-visible{outline:3px solid #fff;outline-offset:3px}
</style>
</head>
<body>
<div class="wrap">
  <div class="bar">
    <span><img src="icons/apple.png" alt="Apples collected" title="Apples collected"><span id="score">0</span></span>
    <span><img src="icons/trophy.png" alt="High score" title="High score"><span id="best">0</span></span>
    <span class="sp"></span>
  </div>
  <div class="stage">
    <canvas id="c" width="680" height="600"></canvas>
    <div class="overlay" id="ov">
      <h1 id="title">Snake</h1>
      <p id="msg">Swipe or use the arrow keys / WASD to move.</p>
      <button id="go">Play</button>
    </div>
  </div>
</div>
<script>
(()=>{
const COLS=17,ROWS=15,S=40,TICK=115;
const c=document.getElementById('c'),x=c.getContext('2d');
const $=id=>document.getElementById(id);
let snake,dir,queue,apple,score,best=+(localStorage.getItem('snake-best')||0),state='idle',last=0,acc=0;
$('best').textContent=best;

function reset(){
  snake=[{x:4,y:7},{x:3,y:7},{x:2,y:7}];dir={x:1,y:0};queue=[];score=0;
  $('score').textContent=0;placeApple();draw();
}
function placeApple(){
  const free=[];
  for(let i=0;i<COLS;i++)for(let j=0;j<ROWS;j++)if(!snake.some(s=>s.x===i&&s.y===j))free.push({x:i,y:j});
  apple=free[Math.floor(Math.random()*free.length)];
}
function show(title,msg,btn){
  $('title').textContent=title;$('msg').textContent=msg;$('go').textContent=btn;$('ov').classList.remove('hide');
}
function start(){
  if(state==='over'||state==='idle')reset();
  state='play';$('ov').classList.add('hide');last=performance.now();acc=0;requestAnimationFrame(loop);
}
function pause(){if(state==='play'){state='pause';show('Paused','Press Space or tap Resume.','Resume');}}
function turn(nx,ny){
  if(state==='idle'||state==='over'||state==='pause'){start();}
  const ref=queue.length?queue[queue.length-1]:dir;
  if(ref.x===-nx&&ref.y===-ny||ref.x===nx&&ref.y===ny)return;
  if(queue.length<3)queue.push({x:nx,y:ny});
}
function step(){
  if(queue.length)dir=queue.shift();
  const h={x:snake[0].x+dir.x,y:snake[0].y+dir.y};
  const eating=h.x===apple.x&&h.y===apple.y;
  const body=eating?snake:snake.slice(0,-1);
  if(h.x<0||h.y<0||h.x>=COLS||h.y>=ROWS||body.some(s=>s.x===h.x&&s.y===h.y))return die();
  snake.unshift(h);
  if(eating){
    score++;$('score').textContent=score;
    if(score>best){best=score;$('best').textContent=best;try{localStorage.setItem('snake-best',best)}catch(e){}}
    if(snake.length===COLS*ROWS){state='over';draw();return show('You win!','The board is full. Score '+score+'.','Play again');}
    placeApple();
  }else snake.pop();
}
function die(){
  state='over';draw();
  show('Game over','Score '+score+(score>=best&&score>0?' — new best!':''),'Play again');
}
function loop(t){
  if(state!=='play')return;
  acc+=t-last;last=t;
  while(acc>=TICK&&state==='play'){acc-=TICK;step();}
  draw();requestAnimationFrame(loop);
}
function draw(){
  for(let i=0;i<COLS;i++)for(let j=0;j<ROWS;j++){
    x.fillStyle=(i+j)%2?'#a2d149':'#aad751';x.fillRect(i*S,j*S,S,S);
  }
  // apple
  const ax=apple.x*S+S/2,ay=apple.y*S+S/2;
  x.fillStyle='#e7471d';x.beginPath();x.arc(ax,ay+2,S*.36,0,7);x.fill();
  x.fillStyle='#ffffff55';x.beginPath();x.arc(ax-6,ay-4,4,0,7);x.fill();
  x.fillStyle='#3f7d20';x.beginPath();x.ellipse(ax+5,ay-S*.34,7,4,-.5,0,7);x.fill();
  // snake body
  x.strokeStyle='#4674e9';x.lineWidth=S*.72;x.lineCap='round';x.lineJoin='round';
  x.beginPath();snake.forEach((s,i)=>{const px=s.x*S+S/2,py=s.y*S+S/2;i?x.lineTo(px,py):x.moveTo(px,py)});
  if(snake.length===1)x.lineTo(snake[0].x*S+S/2+.01,snake[0].y*S+S/2);
  x.stroke();
  // eyes
  const h=snake[0],hx=h.x*S+S/2,hy=h.y*S+S/2,px=-dir.y,py=dir.x;
  for(const side of[-1,1]){
    const ex=hx+dir.x*7+px*side*8,ey=hy+dir.y*7+py*side*8;
    x.fillStyle='#fff';x.beginPath();x.arc(ex,ey,6.5,0,7);x.fill();
    x.fillStyle='#111';x.beginPath();x.arc(ex+dir.x*2,ey+dir.y*2,3.2,0,7);x.fill();
  }
}
// input
const keys={ArrowUp:[0,-1],w:[0,-1],W:[0,-1],ArrowDown:[0,1],s:[0,1],S:[0,1],ArrowLeft:[-1,0],a:[-1,0],A:[-1,0],ArrowRight:[1,0],d:[1,0],D:[1,0]};
addEventListener('keydown',e=>{
  if(keys[e.key]){e.preventDefault();turn(...keys[e.key]);}
  else if(e.key===' '||e.key==='p'||e.key==='P'){e.preventDefault();state==='play'?pause():start();}
});
$('go').addEventListener('click',start);
let t0=null;
addEventListener('touchstart',e=>{t0={x:e.touches[0].clientX,y:e.touches[0].clientY}},{passive:true});
addEventListener('touchmove',e=>{
  if(!t0)return;
  const dx=e.touches[0].clientX-t0.x,dy=e.touches[0].clientY-t0.y;
  if(Math.max(Math.abs(dx),Math.abs(dy))<24)return;
  Math.abs(dx)>Math.abs(dy)?turn(Math.sign(dx),0):turn(0,Math.sign(dy));
  t0={x:e.touches[0].clientX,y:e.touches[0].clientY};
},{passive:true});
addEventListener('touchend',()=>t0=null);
document.addEventListener('visibilitychange',()=>{if(document.hidden)pause()});
reset();
if('serviceWorker'in navigator)addEventListener('load',()=>navigator.serviceWorker.register('sw.js').catch(()=>{}));
})();
</script>
</body>
</html>
